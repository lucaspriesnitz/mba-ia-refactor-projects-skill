# Copie para .env e preencha. O .env NAO vai para o git.
# Gere um valor forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Caminho do banco SQLite. Default: loja.db na raiz do projeto.
DB_PATH=

# Servidor de desenvolvimento. Default seguro: DEBUG desligado e bind local.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Allowlist de CORS, origens separadas por virgula. Vazio = nenhum header CORS.
# Ex.: CORS_ORIGINS=http://localhost:3000,https://loja.exemplo.com
CORS_ORIGINS=

# Validade da credencial emitida no login, em segundos.
TOKEN_TTL_SEGUNDOS=3600

# Paginacao das listagens. LISTAGEM_LIMITE_PADRAO vazio = sem limite (contrato
# original); LISTAGEM_LIMITE_MAXIMO e o teto para o ?limit= informado pelo cliente.
LISTAGEM_LIMITE_PADRAO=
LISTAGEM_LIMITE_MAXIMO=500

# Habilita POST /admin/reset-db (exige, ainda assim, credencial de admin).
# Mantenha false fora de desenvolvimento.
ADMIN_RESET_HABILITADO=false

VERSAO_API=1.0.0
