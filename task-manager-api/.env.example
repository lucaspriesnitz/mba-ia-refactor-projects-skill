# Copie para .env e preencha. O .env NAO vai para o git.
# Obrigatoria (>= 32 caracteres); assina os tokens JWT. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URI SQLAlchemy. Relativa = dentro de instance/ (default: sqlite:///tasks.db).
DATABASE_URL=sqlite:///tasks.db

# Servidor de desenvolvimento. Defaults seguros: debug desligado e bind local.
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Allowlist de CORS, origens separadas por virgula. Vazio = nenhum header CORS.
# Ex.: CORS_ORIGINS=http://localhost:3000,https://app.exemplo.com
CORS_ORIGINS=

# Validade do token emitido no login, em segundos.
TOKEN_TTL_SECONDS=3600

# Tamanho minimo de senha em cadastro e troca.
PASSWORD_MIN_LENGTH=12

# Paginacao das listagens (?limit=&offset=). LIST_DEFAULT_LIMIT vazio = sem
# limite (contrato original); LIST_MAX_LIMIT e o teto do ?limit= do cliente.
LIST_DEFAULT_LIMIT=
LIST_MAX_LIMIT=500
