# Copie para .env e preencha. O .env NÃO vai para o git.
# As variáveis sem default derrubam o boot se estiverem ausentes (fail-fast).

# Credencial das rotas administrativas, enviada como `Authorization: Bearer <token>`.
# Mínimo de 16 caracteres. Gere um valor forte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=

# Chave do gateway de pagamento. A chave que estava no código-fonte
# (`pk_live_...`) foi exposta no histórico do Git e precisa ser REVOGADA no
# provedor, não apenas removida daqui.
PAYMENT_GATEWAY_KEY=

# Implementação do gateway. `fake` é a de desenvolvimento (aprova cartão 4xxx).
PAYMENT_GATEWAY_DRIVER=fake

# Ambiente e servidor.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Banco SQLite persistente. Default: ./data/app.db
DB_PATH=

# Diagnóstico do driver sqlite3 (o antigo `.verbose()`). Nunca liga em produção.
SQLITE_VERBOSE=false

# Seeds de desenvolvimento. Default: ligados fora de produção.
SEED_ENABLED=true
SEED_USER_PASSWORD=dev-seed-password
